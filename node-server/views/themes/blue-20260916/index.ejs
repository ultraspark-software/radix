<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intranet</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/themes/<%= currentTheme %>/css/styles.css" rel="stylesheet">
    <link rel="stylesheet" href="http://yui.yahooapis.com/pure/0.6.0/pure-min.css" />
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark fixed-top navbar-custom px-3">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <img src="http://192.168.147.6/Assets/images/logo_db.png" alt="Astley Gilbert" height="30">
                <span>Bluebook / Resource Centre</span>
            </a>
            <div class="d-flex gap-2" style="max-width: 500px; width: 100%;">
                <input type="search" class="form-control" placeholder="Search...">
                <button class="btn btn-primary" type="button">Search</button>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar Navigation -->
            <aside class="col-md-3 col-lg-2 left-sidebar p-3 text-white">
                <div class="sidebar-btn-container">
                    <div class="d-grid gap-2 mb-4">
                        <%- RadButton('/', 'HOME (Search) Page', 'btn sidebar-btn-custom') %>
                        <%- RadButton('https://workforcenow.adp.com', 'Employee Login', 'btn sidebar-btn-custom', true) %>
                        <%- RadButton('http://192.168.147.82/pidbeta', 'PID Production Site', 'btn sidebar-btn-custom') %>
                        <%- RadButton('https://db-printshop.com/ustoreadmin', 'uStore Admin Backend', 'btn sidebar-btn-custom', true) %>

                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <%- RadButton('http://192.168.147.214:3200', 'Active POPS Reports', 'btn sidebar-btn-custom') %>
                        <%- RadButton('#', 'Submit A POPS Report', 'btn sidebar-btn-custom') %>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <%- RadButton('https://dominionblue.com', 'Dominion Blue Website', 'btn sidebar-btn-custom') %>
                        <%- RadButton('https://db.astleygilbert.com/index.php/solutions-news-archive', 'Past Marketing Emails', 'btn sidebar-btn-custom') %>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <%- RadButton('https://db-printshop.com/DBTeamMembers', 'db Stock Orders', 'btn sidebar-btn-custom') %>
                    </div>

					<div class="d-grid gap-2 mb-4">
                        <%- RadButton('/admin/login', 'Login', 'btn btn-light sidebar-btn d-block w-100') %>
					</div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="col-md-6 col-lg-8 offset-md-3 offset-lg-2 p-4">
				<div class="container">
                    <!-- Show page title if static page. -->
                    <% if (locals.page?.title) { %>
                        <h1><%- page.title %></h1>
                    <% } %>

					<%- content %>
				</div>
            </main>

            <!-- Right Sidebar -->
            <aside class="col-md-3 col-lg-2 right-sidebar p-3 border-start">
                <div class="sidebar-btn-container">
                    <div class="d-grid gap-2">
                        <%- RadButton('http://192.168.147.214:3100', 'Newsroom', 'btn btn-newsroom w-100') %>
                    </div>
                </div>                
            </aside>

        </div>
    </div>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
